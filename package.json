{
  "name": "se-foundations-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Interactive site build of the se-foundations curriculum. modules/ Markdown stays canonical.",
  "scripts": {
    "predev": "node scripts/copy-datasets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-datasets.mjs",
    "build": "astro build --force",
    "preview": "astro preview",
    "test:content": "node scripts/verify-content.mjs",
    "test:sql": "node scripts/verify-sql.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:content && npm run test:sql && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/react": "6.0.5",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "astro": "7.3.2",
    "mermaid": "11.17.2",
    "pyodide": "314.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
