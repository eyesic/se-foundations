---
import { getCollection } from 'astro:content';

interface Props {
  current?: string;
}

const { current } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

// Folder order is curriculum order: 00-start-here through 11-job-search-kit.
const entries = (await getCollection('modules')).sort((a, b) => a.id.localeCompare(b.id));

const modules = entries.map((entry) => {
  const slug = entry.id.replace(/\/readme$/i, '');
  const heading = /^#\s+(.+)$/m.exec(entry.body ?? '');
  return { slug, title: heading ? heading[1].trim() : slug };
});
---

<nav class="nav" aria-label="Modules">
  <a class="nav__home" href={base}>se-foundations</a>
  <ol class="nav__list">
    {
      modules.map((module) => (
        <li>
          <a
            href={`${base}${module.slug}/`}
            aria-current={module.slug === current ? 'page' : undefined}
          >
            {module.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
